__pycache__/
*.pyc
.venv/
venv/
.env
*.json
!.github/**/*.json
# One named, generated file. The blanket *.json rule above is what stops the
# service account key being committed, so this stays an allowlist of exactly
# one path rather than an exception for the backup folder.
!backup/trade_story.json
# Same again for the leaderboard, the other generated file the weekly backup
# commits. Exactly one more path, not a wider exception.
!backup/leaderboard.json
.pytest_cache/
# Feed B leaderboard, written by scripts.leaderboard_b in the weekly backup. One more exact path.
!backup/leaderboard_b.json
